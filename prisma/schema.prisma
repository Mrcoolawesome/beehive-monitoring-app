// Prisma generates a typed database client from this file. Run
// `pnpm exec prisma migrate dev` after changing a model to create and apply
// a migration, and `pnpm exec prisma generate` to regenerate the client
// (the "prisma-client" generator below writes it into app/generated/prisma).
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

// Note: Prisma 7 no longer allows a `url = env("DATABASE_URL")` line here.
// The connection is supplied at runtime by a driver adapter instead — see
// lib/db.ts (@prisma/adapter-pg) for the app, and prisma.config.ts for the
// Prisma CLI (migrate, studio).
datasource db {
  provider = "postgresql"
}

// Auth: email/password only (next-auth v5's Credentials provider), no
// OAuth providers - so no @auth/prisma-adapter and no Account/Session/
// VerificationToken tables. (Auth.js's Credentials provider doesn't
// support database sessions at all - only JWT - which is also why those
// tables wouldn't do anything useful here even if present: see
// https://authjs.dev/getting-started/authentication/credentials.)
// Session "revocability" without a sessions table: auth.ts's jwt callback
// re-reads the user's current role from this table on every request, so a
// role change (or a user getting removed) takes effect on their very next
// request rather than only after their token expires.
enum UserRole {
  ADMIN
  VIEWER
}

model User {
  id    String @id @default(cuid())
  name  String?
  email String  @unique

  // Never the plaintext password.
  hashedPassword String

  // Only an ADMIN can reach /admin (manage Pis/boards/SSH credentials).
  // Everyone else is a read-only VIEWER, scoped to Pis assigned to them
  // (Pi.userId).
  role UserRole @default(VIEWER)

  // A VIEWER only ever sees these Pis (and their boards/readings) on the
  // dashboard - see app/page.tsx. Cascading delete: if a user account is
  // removed, their Pis go with it rather than becoming orphaned rows an
  // admin has to notice and clean up by hand. (Deleting a Pi this way does
  // NOT stop the flight software or decommission hardware - it just drops
  // this app's record of it. The admin panel's own Pi deletion should warn
  // about that separately.)
  pis Pi[]

  createdAt DateTime @default(now())
}

// A Raspberry Pi in the fleet. One dedicated GDS/decoder instance per Pi
// (on `assignedPort`) rather than a shared GDS multiple Pis connect to -
// see the "Multi-Pi / multi-board fleet management" plan for why (avoids
// needing new flight-software protocol work or depending on fprime-gds
// behavior with multiple simultaneous flight-software clients, which isn't
// a scenario it's designed for).
enum PiStatus {
  // Row exists (port assigned, SSH keypair generated) but the one-time
  // physical bootstrap step (installing the generated public key on the
  // Pi) and initial deploy haven't happened yet.
  PENDING_SETUP
  ACTIVE
  DISABLED
}

// Work the admin panel (the Dockerized web app - no ssh/tailscale binaries
// and no tailnet route) can request but not itself perform.
// scripts/deployer.ts (native on devin-server's host, already needs
// ssh/tailscale/docker for its own redeploy loop) polls for these and
// executes them - see that file's handlePendingActions(). Deliberately
// just one nullable field on Pi rather than a separate queue table: at
// most one action is ever pending per Pi (the UI only offers a new action
// once the last one cleared), so a child table wouldn't give anything
// pendingAction/pendingActionRequestedAt don't already.
enum PiPendingAction {
  RESYNC_IP
  INITIAL_SETUP
  // Re-upload the binary/boot sequence/boards.txt and restart the service,
  // without repeating INITIAL_SETUP's systemd-install step. deployer.ts
  // also does this on its own for every ACTIVE Pi when beehive-project's
  // origin/main moves - this is the manual trigger for the other case that
  // doesn't involve a new commit: the admin changed this Pi's boards.
  REDEPLOY
  // "Sync mode" - see the admin panel's "Scan for new board" button and
  // deployer.ts's handleScanForBoards(). Runs a bounded bluetoothctl scan
  // on the Pi (over SSH, independent of the running beedeployment.service -
  // no flight-software or GDS protocol changes needed for this) so the
  // admin doesn't need to already know a new board's MAC address (which
  // isn't printed anywhere convenient) - they press the board's physical
  // sync button while this runs, and the discovered MAC shows up in the
  // admin panel to add as a Board.
  SCAN_FOR_BOARDS
}

model Pi {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The Tailscale MagicDNS hostname (e.g. "beehive0") - what the admin
  // actually enters, not a raw IP: names are what's stable/human-readable,
  // the underlying IP is what SSH/scp/deploy operations actually need and
  // can (rarely) drift. `tailscale ip -4 <name>`, run on devin-server's
  // host (on the tailnet already), resolves it into resolvedIp - both at
  // registration and via the admin panel's "Resync IP" action.
  tailscaleName String
  resolvedIp    String?
  ipResolvedAt  DateTime?

  sshUser                String  @default("pi")
  sshPublicKey           String?
  // AES-256-GCM encrypted, never the raw key - see lib/crypto.ts.
  sshPrivateKeyEncrypted String?

  // Unique so two Pis can never collide on the same dedicated GDS/decoder
  // instance - assigned once at registration (see admin Pi-creation
  // action), starting from 50001.
  assignedPort Int @unique

  status PiStatus @default(PENDING_SETUP)

  lastDeployedSha  String?
  lastDeployedAt   DateTime?

  // Set by an admin action (app/admin/pis/[id]/actions.ts), cleared by
  // deployer.ts once it's handled - see the PiPendingAction comment above.
  pendingAction            PiPendingAction?
  pendingActionRequestedAt DateTime?
  // Set instead of clearing pendingAction silently on failure, so the
  // admin panel can show what went wrong rather than the action just
  // seeming to do nothing. Cleared automatically the next time an action
  // is requested.
  lastActionError String?

  // Result of the most recent SCAN_FOR_BOARDS action - an array of
  // {mac, discoveredAt} objects (Json, not a table: this is a small,
  // disposable, single-admin-workflow result, not data anything else ever
  // queries). Cleared to null the moment a new scan is requested (not just
  // overwritten when one completes), so the admin panel never shows stale
  // results as if they were from the scan just requested - see
  // requestScanForBoardsAction.
  lastScanResults Json?
  lastScanAt      DateTime?

  boards Board[]

  createdAt DateTime @default(now())
}

// A Wii Balance Board paired to a specific Pi. Up to 4 per Pi, matching the
// fixed number of WiiBoardManager instances the flight software declares
// (wiiBoardManager0..wiiBoardManager3) - F' namespaces telemetry/events by
// instance name automatically, so slotIndex is what ties a Board row to
// which instance's data is actually its readings.
model Board {
  id   String @id @default(cuid())
  piId String
  pi   Pi     @relation(fields: [piId], references: [id], onDelete: Cascade)

  bluetoothMac String
  // Admin-friendly label (e.g. "Hive 3 board") - shown in the UI instead
  // of a bare MAC address.
  label String

  // Which WiiBoardManager instance (0..3) this board is deployed to.
  slotIndex Int

  readings WeightReading[]

  createdAt DateTime @default(now())

  // A Pi can't have the same board wired into two slots, or two different
  // boards claiming the same slot.
  @@unique([piId, slotIndex])
  @@unique([piId, bluetoothMac])
}

// One row per ingested F' weight session (see lib/ingest.ts for how a raw
// JSON telemetry file becomes one of these rows).
model WeightReading {
  id String @id @default(cuid())

  // When the session was captured on the Pi (from the F' JSON header), not
  // when we happened to ingest the file.
  timestamp DateTime

  // The averaged weight for the session, in kilograms, after filtering out
  // zero/near-zero sensor-noise samples (see MIN_VALID_WEIGHT_KG).
  averageWeight Float

  // A reading is fundamentally from a specific board (a board belongs to
  // exactly one Pi) - replaces the old flat piMacAddress string field.
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // When this row was written to the database (distinct from `timestamp`,
  // which is when the sensor reading actually happened).
  createdAt DateTime @default(now())

  // Two genuine readings from the same board can never share a timestamp
  // (F's header timestamp is microsecond-precision and each session is ~a
  // minute apart), so this doubles as a de-dup guard: if the same source
  // file ever gets decoded and ingested more than once — e.g. a decoder or
  // watcher restart re-processing something it already handled — upsert-
  // ing on this key makes that a no-op update instead of a duplicate row.
  // See scripts/watcher.ts's use of `upsert` and docs/planning.md's
  // Decisions section for the deployment issue that surfaced the need for
  // this.
  @@unique([boardId, timestamp])
}

// Where the flight software on every Pi connects to (`-a <host>`, baked
// into each Pi's systemd service at deploy time) - a single row, enforced
// by app logic (see app/admin/server/actions.ts) rather than a DB
// constraint, since Postgres has no clean native "at most one row"
// constraint short of a partial unique index on a constant.
model ServerConfig {
  id   String @id @default(cuid())
  host String

  updatedAt DateTime @updatedAt
}
