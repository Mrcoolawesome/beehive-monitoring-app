# Copy this file to .env and fill in real values. Used both for running the
# app directly with pnpm (see README.md's Setup section) AND by
# docker-compose.yml (docker compose auto-loads a .env file in this
# directory) — some keys below are only read by one or the other; each is
# labeled.

# --- Used by: `pnpm dev` / `pnpm watch` (not docker compose) ---

# Connection string for a locally-installed Postgres. docker-compose.yml
# runs its own Postgres container instead and builds its own connection
# string from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below, so this
# key is irrelevant if you're only ever running via Docker.
DATABASE_URL="postgresql://beehive_app:CHANGE_ME@localhost:5432/beehive?schema=public"

# --- Used by both `pnpm watch` AND docker compose (dual-purpose) ---

# The directory F' (or a script relaying its downlinks) drops
# WeightSessionRecord JSON files into.
# - Running directly with `pnpm watch`: this is read as-is — the watcher
#   watches this exact path, and creates processed/ and failed/ subfolders
#   inside it automatically.
# - Running via docker compose: this same path is used as the *host* side
#   of a bind mount (see the watcher service's `volumes:` in
#   docker-compose.yml) — the container always sees it internally as
#   /data/incoming, regardless of what path you put here.
WATCH_DIR="./data/incoming"

# --- Used by: `pnpm watch` only (not read by the Next.js app itself) ---

# Which Pi (see the Pi model in prisma/schema.prisma - register it in the
# admin panel first) this watcher instance's readings belong to. One
# watcher process per Pi, matching one dedicated GDS/decoder pipeline per
# Pi. The watcher fails fast at startup if that Pi doesn't have exactly one
# board configured - see scripts/watcher.ts's resolveBoard() for why
# (multiple boards per Pi need flight-software work this watcher doesn't
# support ingesting from yet).
PI_ID="CHANGE_ME"

# --- Used by both `pnpm dev` AND docker compose ---

# Signs/encrypts session JWTs (next-auth v5 reads this by convention - no
# explicit wiring needed). Generate one with `openssl rand -base64 32`.
# Rotating this invalidates every signed-in session immediately.
AUTH_SECRET="CHANGE_ME"

# --- Used by: docker compose only (configures its own Postgres container) ---

POSTGRES_USER="beehive_app"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="beehive"

# --- Used by: docker compose only (matches the watcher container's file
# ownership to your host user, so it can actually write into WATCH_DIR) ---

# The watcher container runs as this UID:GID rather than root, since its job
# is moving files around inside WATCH_DIR on the host — running as root
# there would leave root-owned files behind that your normal user can't
# clean up without sudo. Defaults to 1000:1000 (the first regular user on
# most Linux distros) if left unset; run `id -u` / `id -g` on the host and
# set these explicitly if that's not you.
# WATCH_UID=1000
# WATCH_GID=1000

# --- Used by: docker compose only ---

# Host-side port the dashboard is published on (container always listens on
# 3000 internally). Only needed if 3000 is already taken by something else
# on the host.
# WEB_PORT=3000
